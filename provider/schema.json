          "type": "string"
        }
      },
      "required": [
        "spaceId",
        "name",
        "description",
        "deploymentType",
        "mysqlCapsuleId",
        "databaseName",
        "storageCapsuleId",
        "cpuQty",
        "cpuUnit",
        "memoryQty",
        "memoryUnit",
        "storageQty",
        "storageUnit",
        "replicas",
        "hostname"
      ],
      "inputProperties": {
        "branch": {
          "type": "string",
          "description": "The branch to deploy from. Required when deploymentType is \"git\", unused for \"default\". Immutable after creation; changing it replaces the resource. Note: creating a \"git\" capsule does not deploy anything by itself - the site goes live on the next push to this branch."
        },
        "cpuQty": {
          "type": "number",
          "description": "CPU request quantity."
        },
        "cpuUnit": {
          "type": "string",
          "description": "CPU request unit, e.g. \"m\". Defaults to \"m\"."
        },
        "databaseName": {
          "type": "string",
          "description": "The database name to use on the referenced MysqlCapsule. Immutable after creation; changing it replaces the resource."
        },
        "deploymentType": {
          "type": "string",
          "description": "Deployment type: \"default\" (stock WordPress version/image) or \"git\" (custom codebase from an already-connected repository). Defaults to \"default\". Immutable after creation."
        },
        "description": {
          "type": "string",
          "description": "The capsule's description. Mutable in place."
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Environment variables for the capsule. Replaces the full set on every change - useful for wiring in a RedisCapsule's connection details.",
          "secret": true
        },
        "gitRepositoryId": {
          "type": "string",
          "description": "The id of a git repository already connected to Code Capsules (connect it via the dashboard first - this resource can only reference an existing connection, not create one). Required when deploymentType is \"git\", unused for \"default\". Immutable after creation; changing it replaces the resource."
        },
        "memoryQty": {
          "type": "number",
          "description": "Memory request quantity."
        },
        "memoryUnit": {
          "type": "string",
          "description": "Memory request unit, e.g. \"M\". Defaults to \"M\"."
        },
        "mysqlCapsuleId": {
          "type": "string",
          "description": "The id of an existing MysqlCapsule (must already be Ready) this site's database. Immutable after creation; changing it replaces the resource."
        },
        "name": {
          "type": "string",
          "description": "The capsule's name. Immutable after creation; changing it replaces the resource (renaming isn't supported)."
        },
        "replicas": {
          "type": "integer",
          "description": "Replica count. Defaults to 1."
        },
        "sourceSubpath": {
          "type": "string",
          "description": "Subpath within the repository where the WordPress root lives, for repositories that aren't WordPress at their root. Optional in either deployment mode. Immutable after creation; changing it replaces the resource."
        },
        "spaceId": {
          "type": "string",
          "description": "The owning Space's id. Immutable after creation; changing it replaces the resource."
        },
        "storageCapsuleId": {
          "type": "string",
          "description": "The id of an existing StorageCapsule for this site's uploads/media. Immutable after creation; changing it replaces the resource."
        },
        "storageQty": {
          "type": "number",
          "description": "Storage request quantity."
        },
        "storageUnit": {
          "type": "string",
          "description": "Storage request unit, e.g. \"Gi\". Defaults to \"Gi\"."
        },
        "version": {
          "type": "string",
          "description": "The WordPress version to deploy. Required when deploymentType is \"default\", unused for \"git\". Immutable after creation; changing it replaces the resource."
        }
      },
      "requiredInputs": [
        "spaceId",
        "name",
        "mysqlCapsuleId",
        "databaseName",
        "storageCapsuleId"
      ]
    }
  }
