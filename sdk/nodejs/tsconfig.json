{
    "compilerOptions": {
        "outDir": "bin",
        "target": "ES2020",
        "module": "commonjs",
        "moduleResolution": "node",
        "declaration": true,
        "sourceMap": true,
        "stripInternal": true,
        "experimentalDecorators": true,
        "noFallthroughCasesInSwitch": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true
    },
    "files": [
        "config/index.ts",
        "config/vars.ts",
        "index.ts",
        "mysqlCapsule.ts",
        "provider.ts",
        "redisCapsule.ts",
        "space.ts",
        "storageCapsule.ts",
        "team.ts",
        "utilities.ts",
        "wordpressCapsule.ts"
    ]
}
